                {
                    "ja": "昔、ここは静かでした。",
                    "en": "This place used to be quiet."
                }
            ],
            "tags": [
                "past",
                "polite"
            ]
        },
        {
            "id": "N5-11",
            "level": "N5",
            "patterns": [
                "〜ではありません"
            ],
