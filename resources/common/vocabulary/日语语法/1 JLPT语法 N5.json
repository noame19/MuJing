            "examples": [
                {
                    "ja": "日本に行ったことがあります。",
                    "en": "I have been to Japan before."
                },
                {
                    "ja": "寿司を食べたことがありません。",
                    "en": "I have never eaten sushi."
                }
            ],
            "tags": [
                "experience"
            ]
        },
        {
