            "examples": [
                {
                    "ja": "友達と映画を見ます。",
                    "en": "I watch a movie with my friend."
                },
                {
                    "ja": "春になると、桜が咲きます。",
                    "en": "When spring comes, cherry blossoms bloom."
                }
            ],
            "tags": [
                "conjunction"
            ]
        },
