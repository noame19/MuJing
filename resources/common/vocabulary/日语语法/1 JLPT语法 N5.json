            "level": "N5",
            "patterns": [
                "〜たい"
            ],
            "meaning": "want to do",
            "formation": "Verb-stem + たい",
            "examples": [
                {
                    "ja": "日本に行きたいです。",
                    "en": "I want to go to Japan."
                },
                {
                    "ja": "水が飲みたいです。",
                    "en": "I want to drink water."
                }
            ],
            "tags": [
                "desire"
            ]
        },
