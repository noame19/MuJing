    "grammarList": [
        {
            "id": "N5-1",
            "level": "N5",
            "patterns": [
                "〜が"
            ],
            "meaning": "but; however",
            "formation": "Clause A + が + Clause B",
            "examples": [
                {
                    "ja": "この本は高いですが、面白いです。",
                    "en": "This book is expensive, but interesting."
                },
                {
                    "ja": "日本語が好きですが、難しいです。",
                    "en": "I like Japanese, but it's difficult."
                }
            ],
            "tags": [
                "conjunction"
            ]
        },
        {
            "id": "N5-2",
            "level": "N5",
            "patterns": [
                "〜がいます",
                "〜があります"
            ],
            "meaning": "there is/are (animate or inanimate)",
            "formation": "Noun + が + います/あります",
            "examples": [
                {
                    "ja": "公園に猫がいます。",
                    "en": "There is a cat in the park."
                },
                {
                    "ja": "机の上に本があります。",
                    "en": "There is a book on the desk."
                }
            ],
            "tags": [
                "existence"
            ]
        },
        {
            "id": "N5-3",
            "level": "N5",
            "patterns": [
                "〜から"
            ],
            "meaning": "because; since",
            "formation": "Sentence + から + Result",
            "examples": [
                {
                    "ja": "雨が降っているから、出かけません。",
                    "en": "Because it's raining, I won't go out."
                },
                {
                    "ja": "眠いから、早く寝ます。",
                    "en": "Because I'm sleepy, I'll go to bed early."
                }
            ],
            "tags": [
                "reason"
            ]
        },
        {
            "id": "N5-4",
            "level": "N5",
            "patterns": [
                "〜が好きです",
                "〜が嫌いです"
            ],
            "meaning": "like / dislike",
            "formation": "Noun/Verb-noun + が + 好きです/嫌いです",
            "examples": [
                {
                    "ja": "私は猫が好きです。",
                    "en": "I like cats."
                },
                {
                    "ja": "彼は野菜が嫌いです。",
                    "en": "He dislikes vegetables."
                }
            ],
            "tags": [
                "preference"
            ]
        },
        {
